{
  "tools": [
    {
      "name": "server_status",
      "title": "Server status",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "description": "Returns the current health and timestamp of the NewTqnia server.",
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "status",
          "application",
          "timestamp"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "application": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "get_recent_news",
      "title": "Get recent published news",
      "inputSchema": {
        "type": "object",
        "properties": {
          "days": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3650,
            "default": 90
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500,
            "default": 100
          },
          "locale": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "en",
              "ar",
              null
            ],
            "default": "en",
            "description": "The calling user's language. Ignored for administrator tokens, which always receive both languages."
          }
        },
        "additionalProperties": false
      },
      "description": "Returns published news from the past X days (90 by default). Administrators get bilingual titles, summaries, and URLs; other accounts get a single locale (pass the caller's language in locale) with a title, summary, and canonical URL to read the full article.",
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "days",
          "count",
          "news"
        ],
        "properties": {
          "days": {
            "type": "integer"
          },
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "news": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "slug",
                "category",
                "image_path",
                "created_at",
                "updated_at"
              ],
              "properties": {
                "id": {
                  "type": "integer"
                },
                "slug": {
                  "type": "string"
                },
                "title_en": {
                  "type": "string"
                },
                "title_ar": {
                  "type": "string"
                },
                "summary_en": {
                  "type": "string"
                },
                "summary_ar": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "summary": {
                  "type": "string"
                },
                "category_id": {
                  "type": "integer"
                },
                "category": {
                  "type": "object",
                  "description": "Full taxonomy record for administrator tokens; {slug, name} for other accounts."
                },
                "image_path": {
                  "type": "string"
                },
                "created_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "updated_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "url_en": {
                  "type": "string",
                  "format": "uri"
                },
                "url_ar": {
                  "type": "string",
                  "format": "uri"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "get_news_by_id",
      "title": "Get a news article by ID",
      "inputSchema": {
        "type": "object",
        "required": [
          "news_id"
        ],
        "properties": {
          "news_id": {
            "type": "integer",
            "minimum": 1,
            "description": "The exact NewTqnia article ID."
          },
          "locale": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "en",
              "ar",
              null
            ],
            "default": "en",
            "description": "The calling user's language. Ignored for administrator tokens, which always receive both languages."
          }
        },
        "additionalProperties": false
      },
      "description": "Returns one published article. Administrators get the complete bilingual record, including bodies, tags, citations, and access to unpublished drafts. Other accounts get a single locale (pass the caller's language in locale) with a title, summary, and canonical URL to read the full article - never the article body.",
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "id",
          "slug",
          "category",
          "tags",
          "citations",
          "image_path",
          "read_time",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "source": {
            "type": "string",
            "enum": [
              "fresh",
              "archived"
            ]
          },
          "editable": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "published"
            ]
          },
          "slug": {
            "type": "string"
          },
          "title_en": {
            "type": "string"
          },
          "title_ar": {
            "type": "string"
          },
          "summary_en": {
            "type": "string"
          },
          "summary_ar": {
            "type": "string"
          },
          "body_en": {
            "type": "string"
          },
          "body_ar": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "category": {
            "type": "object",
            "description": "Full taxonomy record for administrator tokens; {slug, name} for other accounts."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "citations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "title",
                "url"
              ],
              "properties": {
                "id": {
                  "type": "integer"
                },
                "title": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "additionalProperties": false
            }
          },
          "image_path": {
            "type": "string"
          },
          "read_time": {
            "type": "integer",
            "minimum": 1
          },
          "view_count": {
            "type": "integer",
            "minimum": 0
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "url_en": {
            "type": "string",
            "format": "uri"
          },
          "url_ar": {
            "type": "string",
            "format": "uri"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "get_timeline_by_id",
      "title": "Get a timeline by ID",
      "inputSchema": {
