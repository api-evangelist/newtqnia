              "null"
            ]
          },
          "timeline_type": {
            "type": "string"
          },
          "featured": {
            "type": "boolean"
          },
          "is_ongoing": {
            "type": "boolean"
          },
          "start_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "end_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "event_count": {
            "type": "integer"
          },
          "cover_media": {
            "type": [
              "object",
              "null"
            ]
          },
          "events": {
            "type": "array",
