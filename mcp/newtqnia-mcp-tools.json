            ]
          },
          "title_en": {
            "type": "string"
          },
          "title_ar": {
            "type": "string"
          },
          "summary_en": {
            "type": "string"
          },
          "summary_ar": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "introduction_en": {
            "type": [
              "string",
